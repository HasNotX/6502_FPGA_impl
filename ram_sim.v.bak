// =============================================================================
// ram_sim.v  —  Simulation / functional-test RAM
//
// This version uses COMBINATORIAL (asynchronous) reads.
// address → data_out is valid in the same delta cycle — zero read latency.
// This matches the real 6502's assumption of asynchronous memory and lets
// the FSM's _WAIT states act purely as timing insulators rather than
// read-latency compensators.
//
// Use this file for:
//   • RTL simulation (ModelSim, Questa, VCS, Icarus)
//   • Klaus Dörmann 6502 functional test
//   • Any testbench where cycle-exact behaviour matters
//
// For FPGA synthesis use ram_fpga.v (registered read + explicit BRAM
// primitive or inferred M10K/RAMB36 with output register disabled).
// =============================================================================

`timescale 1ns/1ps
module ram (
    input            clk,
    input  [15:0]    addr,
    input  [7:0]     data_in,
    input            write_en,
    output [7:0]     data_out    // combinatorial — valid same cycle as addr
);

reg [7:0] mem [0:65535];

// ── Asynchronous read ──────────────────────────────────────────────────────
assign data_out = mem[addr];

// ── Synchronous write ──────────────────────────────────────────────────────
always @(posedge clk) begin
    if (write_en)
        mem[addr] <= data_in;
end

// ── Initialisation ─────────────────────────────────────────────────────────
// For the Klaus test: load the binary externally with $readmemh in the tb.
// The default init below is for the existing register-check testbench.
integer i;
initial begin
    for (i = 0; i < 65536; i = i + 1)
        mem[i] = 8'hEA;   // NOP sled

    // ── Scratch data ────────────────────────────────────────────────────
    mem[16'h0010] = 8'h55;
    mem[16'h0020] = 8'hAA;
    mem[16'h0021] = 8'h66;
    mem[16'h0030] = 8'hBB;
    mem[16'h0031] = 8'hBB;
    mem[16'h0032] = 8'h77;
    mem[16'h0200] = 8'h88;
    mem[16'h0203] = 8'h99;
    mem[16'h0204] = 8'hAA;

    // ── IRQ/BRK vector → $8500 ──────────────────────────────────────────
    mem[16'hFFFE] = 8'h00;
    mem[16'hFFFF] = 8'h85;

    // ── Program ─────────────────────────────────────────────────────────
    mem[16'h8000] = 8'hA2; mem[16'h8001] = 8'h11;
    mem[16'h8002] = 8'hA6; mem[16'h8003] = 8'h10;
    mem[16'h8004] = 8'hA0; mem[16'h8005] = 8'h01;
    mem[16'h8006] = 8'hA4; mem[16'h8007] = 8'h10;
    mem[16'h8008] = 8'hA2; mem[16'h8009] = 8'h01;
    mem[16'h800A] = 8'hB4; mem[16'h800B] = 8'h20;
    mem[16'h800C] = 8'hA0; mem[16'h800D] = 8'h02;
    mem[16'h800E] = 8'hB6; mem[16'h800F] = 8'h30;
    mem[16'h8010] = 8'hAE; mem[16'h8011] = 8'h00; mem[16'h8012] = 8'h02;
    mem[16'h8013] = 8'hAC; mem[16'h8014] = 8'h00; mem[16'h8015] = 8'h02;
    mem[16'h8016] = 8'hA0; mem[16'h8017] = 8'h03;
    mem[16'h8018] = 8'hBE; mem[16'h8019] = 8'h00; mem[16'h801A] = 8'h02;
    mem[16'h801B] = 8'hA2; mem[16'h801C] = 8'h04;
    mem[16'h801D] = 8'hBC; mem[16'h801E] = 8'h00; mem[16'h801F] = 8'h02;
    mem[16'h8020] = 8'hA9; mem[16'h8021] = 8'hBB;
    mem[16'h8022] = 8'h00;
    mem[16'h8023] = 8'h00;
    mem[16'h8500] = 8'hA9; mem[16'h8501] = 8'hCC;
    mem[16'h8502] = 8'h40;
    mem[16'h8024] = 8'hA9; mem[16'h8025] = 8'hDD;
    mem[16'h8026] = 8'h4C; mem[16'h8027] = 8'h26; mem[16'h8028] = 8'h80;

    // ── Reset vector → $8000 ────────────────────────────────────────────
    mem[16'hFFFC] = 8'h00;
    mem[16'hFFFD] = 8'h80;
end

endmodule