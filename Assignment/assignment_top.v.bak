/*
 * File: assignment_top.v
 * Description: Standalone top-level for DSD Circle Drawing assignment.
 * Utilizes a dual-port RAM framebuffer to bridge the Bresenham FSM (which plots 
 * non-linearly) and the VGA Sync Generator (which reads linearly).
 */

module assignment_top (
    input  wire        CLOCK_50,
    input  wire [3:0]  KEY,      // KEY[3] = Reset, KEY[0] = Draw
    input  wire [17:0] SW,       // SW[7:3] = Radius, SW[2:0] = Color
    
    // VGA Outputs to DAC
    output wire [9:0]  VGA_R,
    output wire [9:0]  VGA_G,
    output wire [9:0]  VGA_B,
    output wire        VGA_HS,
    output wire        VGA_VS,
    output wire        VGA_BLANK_N,
    output wire        VGA_SYNC_N,
    output wire        VGA_CLK
);

    wire clk_25mhz;
    
    // 1. ALTPLL Instance (50 MHz to 25.175 MHz)
    // (Assume standard Quartus IP generation here)
    vga_pll pll_inst (
        .refclk(CLOCK_50),
        .rst(~KEY[3]),
        .outclk_0(clk_25mhz)
    );

    // 2. Dual-Port Framebuffer RAM
    // Since the assignment specifies a 160x120 grid to save memory, 
    // we need 19,200 memory addresses. 15 bits can address up to 32,768.
    wire [14:0] fsm_ram_addr;
    wire [2:0]  fsm_ram_data_in;
    wire        fsm_ram_we;
    
    wire [14:0] vga_ram_addr;
    wire [2:0]  vga_ram_data_out;

    framebuffer_ram fb_ram (
        .clock      (clk_25mhz),
        // Port A: Written by the Bresenham FSM
        .data       (fsm_ram_data_in),
        .rdaddress  (vga_ram_addr),
        .wraddress  (fsm_ram_addr),
        .wren       (fsm_ram_we),
        // Port B: Read by the VGA Sync logic
        .q          (vga_ram_data_out)
    );

    // 3. VGA Sync Generator (Reused from NES project)
    wire [9:0] pixel_x;
    wire [9:0] pixel_y;
    wire       video_on;

    vga_sync_generator sync_gen (
        .clk        (clk_25mhz),
        .reset      (~KEY[3]),
        .h_sync     (VGA_HS),
        .v_sync     (VGA_VS),
        .video_on   (video_on),
        .pixel_x    (pixel_x),
        .pixel_y    (pixel_y)
    );

    // Read Logic: Map the 640x480 beam coordinates to the 160x120 Framebuffer.
    // Dividing by 4 (right shift by 2) scales the 160x120 image up to fill the screen.
    wire [7:0] read_x = pixel_x[9:2]; // 0 to 159
    wire [6:0] read_y = pixel_y[9:2]; // 0 to 119
    assign vga_ram_addr = (read_y * 160) + read_x;
    
    assign VGA_BLANK_N = video_on;
    assign VGA_SYNC_N  = 1'b0;
    assign VGA_CLK     = clk_25mhz;

    // Output Color mapping (3-bit to 30-bit)
    assign VGA_R = (video_on && vga_ram_data_out[2]) ? 10'h3FF : 10'h000;
    assign VGA_G = (video_on && vga_ram_data_out[1]) ? 10'h3FF : 10'h000;
    assign VGA_B = (video_on && vga_ram_data_out[0]) ? 10'h3FF : 10'h000;

    // 4. Instantiate the Bresenham Datapath/FSM Here
    // bresenham_fsm fsm_inst (...)

endmodule

// Standard Dual-Port RAM inferred for Cyclone V
module framebuffer_ram (
    input  wire        clock,
    input  wire [2:0]  data,
    input  wire [14:0] rdaddress,
    input  wire [14:0] wraddress,
    input  wire        wren,
    output reg  [2:0]  q
);
    reg [2:0] ram [0:19199];
    always @(posedge clock) begin
        if (wren) ram[wraddress] <= data;
        q <= ram[rdaddress];
    end
endmodule